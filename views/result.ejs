<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Link Created — ShortDesk</title>
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="theme-color" content="#10b981">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Mono:wght@300;400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <div class="noise-overlay"></div>

  <!-- NAV -->
<nav class="landing-nav" id="mainNav">
  <div class="landing-nav-inner">
    <a href="/" class="nav-logo">
      <img src="/assets/dm.png" alt="ShortDesk" class="nav-logo-img logo-dark">
      <img src="/assets/lm.png" alt="ShortDesk" class="nav-logo-img logo-light">
      <span class="nav-logo-text">ShortDesk</span>
    </a>
    <div class="nav-center">
      <a href="/">Home</a>
      <a href="/#features">Features</a>
      <a href="https://github.com/aminilay/shortdesk-official" target="_blank">GitHub</a>
      <a href="/dashboard">Dashboard</a>
    </div>
    <div class="nav-right">
      <button class="theme-toggle" onclick="toggleTheme()" aria-label="Toggle theme">
        <span id="themeIcon">&#9789;</span>
      </button>
      <a href="/" class="btn btn-primary btn-sm nav-cta">New Link</a>
    </div>
  </div>
</nav>

  <!-- PAGE HEADER -->
  <section class="page-header">
    <div class="page-header-inner">
      <div class="section-eyebrow">Success</div>
      <h1 class="page-title">Link Created</h1>
      <p class="page-sub">Your short link is ready to share</p>
    </div>
  </section>

  <!-- CONTENT -->
  <section class="dash-content">
    <div class="dash-content-inner" style="max-width:640px">

      <div class="dash-card reveal-scroll" style="margin-bottom:24px">

        <!-- Short URL -->
        <div class="field-group">
          <label class="field-label">Your Short Link</label>
          <div class="input-row">
            <input type="text" id="shortUrlInput" value="<%= shortUrl %>" readonly>
            <button class="btn btn-primary btn-sm" onclick="copyShortUrl()">Copy</button>
          </div>
        </div>

        <!-- Original URL -->
        <div class="field-group">
          <label class="field-label">Original URL</label>
          <p class="link-display"><a href="<%= link.originalUrl %>" target="_blank"><%= link.originalUrl %></a></p>
        </div>

        <!-- Meta -->
        <div class="meta-row">
          <div class="meta-item">Short ID: <span><%= link.shortId %></span></div>
          <% if (link.hasPassword) { %>
            <div class="meta-item">&#128274; <span>Protected</span></div>
          <% } %>
          <% if (link.expiresAt) { %>
            <div class="meta-item">&#9200; Expires: <span><%= new Date(link.expiresAt).toLocaleDateString() %></span></div>
          <% } %>
          <% if (link.webhookUrl) { %>
            <div class="meta-item">&#128276; <span>Webhook active</span></div>
          <% } %>
        </div>
      </div>

      <!-- QR CODE -->
      <div class="dash-card reveal-scroll" style="--reveal-delay:0.1s;text-align:center">
        <label class="field-label" style="margin-bottom:12px">QR Code</label>
        <div class="qr-section">
          <img src="<%= qrUrl %>" alt="QR Code for <%= shortUrl %>" width="180" height="180"
               style="border-radius:12px;background:#fff;padding:10px">
          <a href="<%= qrUrl %>" download="shortdesk-<%= link.shortId %>.png" class="btn btn-ghost btn-sm">
            Download PNG
          </a>
        </div>
      </div>

      <!-- ACTIONS -->
      <div class="button-group" style="margin-top:32px">
        <a href="/" class="btn btn-primary">Create Another</a>
        <a href="/analytics/<%= link.shortId %>" class="btn btn-accent-outline">View Analytics</a>
        <a href="/dashboard" class="btn btn-ghost">Dashboard</a>
      </div>

    </div>
  </section>

  <!-- FOOTER -->
<footer class="landing-footer">
  <div class="footer-inner">
    <div class="footer-col footer-brand-col">
      <div class="footer-logo">
        <img src="/assets/dm.png" alt="ShortDesk" class="footer-logo-img logo-dark">
        <img src="/assets/lm.png" alt="ShortDesk" class="footer-logo-img logo-light">
        <span class="footer-brand">ShortDesk</span>
      </div>
      <p class="footer-tagline">Smart, trackable, password-protected short links. Open source and free forever.</p>
    </div>
    <div class="footer-col">
      <h4 class="footer-col-title">Product</h4>
      <a href="/">Home</a>
      <a href="/#features">Features</a>
      <a href="/dashboard">Dashboard</a>
      <a href="/">Create Link</a>
    </div>
    <div class="footer-col">
      <h4 class="footer-col-title">Resources</h4>
      <a href="/docs">Documentation</a>
      <a href="https://github.com/aminilay/shortdesk-official" target="_blank">GitHub</a>
      <a href="https://github.com/aminilay/shortdesk-official/blob/main/LICENSE" target="_blank">License (MIT)</a>
      <a href="https://github.com/aminilay/shortdesk-official/issues" target="_blank">Report Issue</a>
    </div>
    <div class="footer-col">
      <h4 class="footer-col-title">Legal</h4>
      <a href="/privacy">Privacy Policy</a>
      <a href="/terms">Terms of Service</a>
      <a href="https://github.com/aminilay" target="_blank">Contact</a>
    </div>
  </div>
  <div class="footer-bottom">
    <span>&copy; 2025 ShortDesk. Built by <a href="https://github.com/aminilay" target="_blank">Nilay</a></span>
  </div>
</footer>

  <script>
    function copyShortUrl() {
      var input = document.getElementById('shortUrlInput');
      input.select();
      input.setSelectionRange(0, 99999);
      navigator.clipboard.writeText(input.value).then(function() {
        var btn = input.nextElementSibling;
        btn.textContent = 'Copied!';
        btn.classList.add('btn-glow');
        setTimeout(function() {
          btn.textContent = 'Copy';
          btn.classList.remove('btn-glow');
        }, 2000);
      });
    }
  </script>
  <script>
    (function() {
      var saved = localStorage.getItem('shortdesk-theme');
      if (saved) document.documentElement.setAttribute('data-theme', saved);
      updateIcon();
    })();
    function toggleTheme() {
      var current = document.documentElement.getAttribute('data-theme');
      var next = current === 'light' ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('shortdesk-theme', next);
      updateIcon();
    }
    function updateIcon() {
      var t = document.documentElement.getAttribute('data-theme');
      document.getElementById('themeIcon').innerHTML = t === 'light' ? '&#9790;' : '&#9789;';
    }
  </script>
  <script>
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          var delay = entry.target.style.getPropertyValue('--reveal-delay') || '0s';
          entry.target.style.transitionDelay = delay;
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.08 });
    document.querySelectorAll('.reveal-scroll, .dash-card').forEach(function(el) {
      observer.observe(el);
    });
  </script>
</body>
</html>