<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Protected Link — ShortDesk</title>
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="theme-color" content="#10b981">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Mono:wght@300;400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <div class="noise-overlay"></div>

  <!-- NAV -->
  <nav class="landing-nav scrolled">
    <div class="landing-nav-inner">
      <a href="/" class="nav-logo">
        <img src="/assets/dm.png" alt="ShortDesk" class="nav-logo-img logo-dark">
        <img src="/assets/lm.png" alt="ShortDesk" class="nav-logo-img logo-light">
        <span class="nav-logo-text">ShortDesk</span>
      </a>
      <div class="nav-center">
        <a href="/">Home</a>
        <a href="/#features">Features</a>
        <a href="https://github.com/aminilay/shortdesk-official" target="_blank">GitHub</a>
        <a href="/dashboard">Dashboard</a>
      </div>
      <div class="nav-right">
        <button class="theme-toggle" onclick="toggleTheme()" aria-label="Toggle theme">
          <span id="themeIcon">&#9789;</span>
        </button>
        <a href="/" class="btn btn-primary btn-sm nav-cta">New Link</a>
      </div>
    </div>
  </nav>

  <!-- PAGE HEADER -->
  <section class="page-header">
    <div class="page-header-inner">
      <div class="section-eyebrow">Protected</div>
      <h1 class="page-title">Password Required</h1>
      <p class="page-sub">This link is password-protected. Enter the password to continue.</p>
    </div>
  </section>

  <!-- CONTENT -->
  <section class="dash-content">
    <div class="dash-content-inner" style="max-width:480px; margin:0 auto;">

      <div class="dash-card reveal-scroll" style="text-align:center; padding:48px 36px;">

        <div class="lock-icon" style="font-size:3.5rem; margin-bottom:20px;">&#128274;</div>

        <h2 style="font-family:var(--font-display); font-weight:700; font-size:1.3rem; color:var(--text-primary); margin-bottom:8px; transition:color 0.3s;">
          Enter Password
        </h2>
        <p style="color:var(--text-muted); font-size:0.88rem; line-height:1.7; margin-bottom:28px; transition:color 0.3s;">
          The creator of this link has protected it with a password.
        </p>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert-error" style="margin-bottom:20px; text-align:left;">
            <%= error %>
          </div>
        <% } %>

        <form class="password-form" method="POST" action="/<%= shortId %>/verify">
          <div class="form-group" style="width:100%; margin-bottom:16px;">
            <label for="password" style="font-size:0.75rem; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.08em; font-weight:500; display:block; margin-bottom:8px; text-align:left; transition:color 0.3s;">Password</label>
            <input
              type="password"
              id="password"
              name="password"
              placeholder="Enter the link password"
              required
              autofocus
              style="width:100%; padding:14px 16px; border-radius:10px; border:1px solid var(--border); background:var(--input-bg); color:var(--text-primary); font-family:var(--font-mono); font-size:0.95rem; outline:none; transition:border-color 0.2s, box-shadow 0.2s, background 0.3s, color 0.3s;"
            >
          </div>
          <button type="submit" class="btn btn-primary btn-lg" style="width:100%;">
            Unlock Link
          </button>
        </form>

        <p style="margin-top:20px; font-size:0.78rem; color:var(--text-dim); transition:color 0.3s;">
          Passwords are securely hashed. We never see them in plain text.
        </p>

      </div>

    </div>
  </section>

  <!-- FOOTER -->
  <footer class="landing-footer">
    <div class="footer-inner">
      <div class="footer-col footer-brand-col">
        <div class="footer-logo">
          <img src="/assets/dm.png" alt="ShortDesk" class="footer-logo-img logo-dark">
          <img src="/assets/lm.png" alt="ShortDesk" class="footer-logo-img logo-light">
          <span class="footer-brand">ShortDesk</span>
        </div>
        <p class="footer-tagline">Smart, trackable, password-protected short links. Open source and free forever.</p>
      </div>
      <div class="footer-col">
        <h4 class="footer-col-title">Product</h4>
        <a href="/">Home</a>
        <a href="/#features">Features</a>
        <a href="/dashboard">Dashboard</a>
        <a href="/">Create Link</a>
      </div>
      <div class="footer-col">
        <h4 class="footer-col-title">Resources</h4>
        <a href="/docs">Documentation</a>
        <a href="https://github.com/aminilay/shortdesk-official" target="_blank">GitHub</a>
        <a href="https://github.com/aminilay/shortdesk-official/blob/main/LICENSE" target="_blank">License (MIT)</a>
        <a href="https://github.com/aminilay/shortdesk-official/issues" target="_blank">Report Issue</a>
      </div>
      <div class="footer-col">
        <h4 class="footer-col-title">Legal</h4>
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms of Service</a>
        <a href="https://github.com/aminilay" target="_blank">Contact</a>
      </div>
    </div>
    <div class="footer-bottom">
      <span>&copy; 2025 ShortDesk. Built by <a href="https://github.com/aminilay" target="_blank">Nilay</a></span>
    </div>
  </footer>

  <!-- SCRIPTS -->
  <script>
    (function() {
      var saved = localStorage.getItem('shortdesk-theme');
      if (saved) document.documentElement.setAttribute('data-theme', saved);
      updateIcon();
    })();
    function toggleTheme() {
      var current = document.documentElement.getAttribute('data-theme');
      var next = current === 'light' ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('shortdesk-theme', next);
      updateIcon();
    }
    function updateIcon() {
      var t = document.documentElement.getAttribute('data-theme');
      var el = document.getElementById('themeIcon');
      if (el) el.innerHTML = t === 'light' ? '&#9790;' : '&#9789;';
    }
  </script>
  <script>
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          var delay = entry.target.style.getPropertyValue('--reveal-delay') || '0s';
          entry.target.style.transitionDelay = delay;
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.05, rootMargin: '0px 0px -20px 0px' });
    document.querySelectorAll('.reveal-scroll, .dash-card').forEach(function(el) {
      observer.observe(el);
    });
  </script>
</body>
</html>