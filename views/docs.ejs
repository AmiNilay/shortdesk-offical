        <!-- QUICK START -->
        <div class="docs-block reveal-scroll" id="quick-start">
          <h2>Quick Start</h2>
          <p>ShortDesk is a free, open-source URL shortener. No account required.</p>
          <div class="docs-steps">
            <div class="docs-step">
              <span class="docs-step-num">1</span>
              <div>
                <h4>Go to the homepage</h4>
                <p>Visit <code>/</code> or click <strong>Get Started</strong> in the navbar.</p>
              </div>
            </div>
            <div class="docs-step">
              <span class="docs-step-num">2</span>
              <div>
                <h4>Paste your URL</h4>
                <p>Enter any valid URL in the input field.</p>
              </div>
            </div>
            <div class="docs-step">
              <span class="docs-step-num">3</span>
              <div>
                <h4>Click Shorten</h4>
                <p>You will get a short URL, a copy button, and a QR code instantly.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- CREATE LINK -->
        <div class="docs-block reveal-scroll" id="create-link">
          <h2>Create a Short Link</h2>
          <p>
            Enter any valid URL starting with <code>http://</code> or <code>https://</code>.
            ShortDesk will generate a unique 6-character code using Base62 encoding.
          </p>
          <div class="docs-code-block">
            <div class="docs-code-bar">
              <span class="dot red"></span>
              <span class="dot yellow"></span>
              <span class="dot green"></span>
              <span class="docs-code-lang">Example</span>
            </div>
            <pre><code>Original:  https://example.com/very/long/path/to/page
Shortened: https://your-domain.com/Ab3xK9</code></pre>
          </div>
        </div>

        <!-- CUSTOM ALIAS -->
        <div class="docs-block reveal-scroll" id="custom-alias">
          <h2>Custom Alias</h2>
          <p>
            You can optionally provide a custom alias instead of the auto-generated code.
            Aliases must be 3-30 characters, using letters, numbers, hyphens, and underscores.
          </p>
          <div class="docs-code-block">
            <div class="docs-code-bar">
              <span class="dot red"></span>
              <span class="dot yellow"></span>
              <span class="dot green"></span>
              <span class="docs-code-lang">Example</span>
            </div>
            <pre><code>Custom alias: my-portfolio
Result:      https://your-domain.com/my-portfolio</code></pre>
          </div>
          <div class="docs-callout">
            <strong>Note:</strong> If the alias is already taken, you will be asked to choose a different one.
          </div>
        </div>

        <!-- PASSWORD PROTECTION -->
        <div class="docs-block reveal-scroll" id="password-protection">
          <h2>Password Protection</h2>
          <p>
            You can protect any link with a password. When someone visits a protected link,
            they must enter the correct password before being redirected.
          </p>
          <ul>
            <li>Passwords are hashed with <strong>bcrypt</strong> before storage</li>
            <li>A session cookie is set on successful entry (expires in 24 hours)</li>
            <li>The original URL is never exposed until authentication succeeds</li>
          </ul>
        </div>

        <!-- EXPIRY -->
        <div class="docs-block reveal-scroll" id="expiry">
          <h2>Link Expiry</h2>
          <p>Set an expiration time for any link. Available options:</p>
          <div class="docs-table-wrap">
            <table class="docs-table">
              <thead>
                <tr>
                  <th>Option</th>
                  <th>Duration</th>
                </tr>
              </thead>
              <tbody>
                <tr><td><code>never</code></td><td>Link never expires (default)</td></tr>
                <tr><td><code>1h</code></td><td>1 hour from creation</td></tr>
                <tr><td><code>1d</code></td><td>1 day from creation</td></tr>
                <tr><td><code>7d</code></td><td>7 days from creation</td></tr>
                <tr><td><code>30d</code></td><td>30 days from creation</td></tr>
              </tbody>
            </table>
          </div>
          <p>Expired links show a friendly expiration page instead of redirecting.</p>
        </div>

        <!-- WEBHOOKS -->
        <div class="docs-block reveal-scroll" id="webhooks">
          <h2>Webhooks</h2>
          <p>
            Get notified when your link hits a click threshold or expires. ShortDesk
            sends a <code>POST</code> request to your webhook URL with this payload:
          </p>
          <div class="docs-code-block">
            <div class="docs-code-bar">
              <span class="dot red"></span>
              <span class="dot yellow"></span>
              <span class="dot green"></span>
              <span class="docs-code-lang">JSON Payload</span>
            </div>
            <pre><code>{
  "event": "threshold_reached",
  "shortId": "Ab3xK9",
  "shortUrl": "https://your-domain.com/Ab3xK9",
  "originalUrl": "https://example.com/long-path",
  "totalClicks": 100,
  "threshold": 100,
  "timestamp": "2025-07-27T12:00:00.000Z"
}</code></pre>
          </div>
          <p>For expiry events, <code>"event"</code> will be <code>"link_expired"</code>.</p>
        </div>

        <!-- ANALYTICS -->
        <div class="docs-block reveal-scroll" id="analytics">
          <h2>Analytics</h2>
          <p>Every short link has a dedicated analytics page showing:</p>
          <ul>
            <li>Total clicks</li>
            <li>Clicks over time (bar chart, last 14 days)</li>
            <li>Country breakdown</li>
            <li>Device, browser, and OS breakdowns</li>
            <li>Referrer sources</li>
            <li>Date-range filtering for click history</li>
          </ul>
          <p>
            Access analytics from the Dashboard by clicking <strong>Analytics</strong>
            next to any link, or visit <code>/analytics/{shortId}</code> directly.
          </p>
        </div>

        <!-- API -->
        <div class="docs-block reveal-scroll" id="api">
          <h2>API Reference</h2>
          <p>ShortDesk exposes a REST API for programmatic access.</p>

          <h3>POST /shorten</h3>
          <p>Shorten a URL via the API.</p>
          <div class="docs-code-block">
            <div class="docs-code-bar">
              <span class="dot red"></span>
              <span class="dot yellow"></span>
              <span class="dot green"></span>
              <span class="docs-code-lang">curl</span>
            </div>
            <pre><code>curl -X POST https://your-domain.com/shorten \
  -H "Content-Type: application/json" \
  -d '{
    "originalUrl": "https://example.com/long-path",
    "customAlias": "my-link",
    "password": "optional-password",
    "expiry": "7d",
    "webhookUrl": "https://your-webhook.com/notify",
    "clickThreshold": 100
  }'</code></pre>
          </div>

          <h3>GET /api/qr/{shortId}</h3>
          <p>Get a QR code image for any short link.</p>
          <div class="docs-code-block">
            <div class="docs-code-bar">
              <span class="dot red"></span>
              <span class="dot yellow"></span>
              <span class="dot green"></span>
              <span class="docs-code-lang">Example</span>
            </div>
            <pre><code>GET /api/qr/Ab3xK9?size=200
Returns: PNG image (200x200)</code></pre>
          </div>

          <h3>GET /{shortId}</h3>
          <p>
            Redirects to the original URL. If the link is password-protected,
            shows the password entry page.
          </p>
        </div>

        <!-- SELF HOST -->
        <div class="docs-block reveal-scroll" id="self-host">
          <h2>Self-Hosting</h2>
          <p>ShortDesk can be deployed on your own infrastructure.</p>

          <h3>Prerequisites</h3>
          <ul>
            <li>Node.js 18+</li>
            <li>MongoDB 6+ (or MongoDB Atlas)</li>
            <li>Redis (optional, for caching redirects)</li>
          </ul>

          <h3>Installation</h3>
          <div class="docs-code-block">
            <div class="docs-code-bar">
              <span class="dot red"></span>
              <span class="dot yellow"></span>
              <span class="dot green"></span>
              <span class="docs-code-lang">Terminal</span>
            </div>
            <pre><code># Clone the repository
git clone https://github.com/aminilay/shortdesk-official.git
cd shortdesk-official

# Install dependencies
npm install

# Create environment file
cp .env.example .env
# Edit .env with your MongoDB URI and session secret

# Start the server
npm start</code></pre>
          </div>

          <h3>Environment Variables</h3>
          <div class="docs-table-wrap">
            <table class="docs-table">
              <thead>
                <tr>
                  <th>Variable</th>
                  <th>Required</th>
                  <th>Description</th>
                </tr>
              </thead>
              <tbody>
                <tr><td><code>MONGO_URI</code></td><td>Yes</td><td>MongoDB connection string</td></tr>
                <tr><td><code>SESSION_SECRET</code></td><td>Yes</td><td>Secret for session cookies</td></tr>
                <tr><td><code>PORT</code></td><td>No</td><td>Server port (default: 3000)</td></tr>
                <tr><td><code>NODE_ENV</code></td><td>No</td><td><code>production</code> or <code>development</code></td></tr>
                <tr><td><code>GOOGLE_SAFE_BROWSING_KEY</code></td><td>No</td><td>Google Safe Browsing API key</td></tr>
              </tbody>
            </table>
          </div>

          <h3>Deploy to Vercel</h3>
          <div class="docs-code-block">
            <div class="docs-code-bar">
              <span class="dot red"></span>
              <span class="dot yellow"></span>
              <span class="dot green"></span>
              <span class="docs-code-lang">Terminal</span>
            </div>
            <pre><code># Install Vercel CLI
npm i -g vercel

# Deploy
vercel

# Set environment variables in Vercel dashboard
# Settings → Environment Variables</code></pre>
          </div>
        </div>

