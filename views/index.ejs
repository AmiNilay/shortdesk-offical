  <!-- ============ FOOTER ============ -->
  <%- include('partials/footer') %>

  <!-- ============ SCRIPTS ============ -->
  <script>
    // ============================================================
    //  TAB SWITCH
    // ============================================================
    function switchTab(name, el) {
      document.querySelectorAll('.tab').forEach(function(t) { t.classList.remove('active'); });
      document.querySelectorAll('.tab-content').forEach(function(t) { t.classList.remove('active'); });
      document.getElementById('tab-' + name).classList.add('active');
      el.classList.add('active');
    }

    // ============================================================
    //  SMOOTH SCROLL — with nav-hide guard
    // ============================================================
    var isAnchorScroll = false;
    var anchorTimeout = null;

    document.querySelectorAll('.nav-anchor, a[href^="#"]').forEach(function(a) {
      a.addEventListener('click', function(e) {
        var href = this.getAttribute('href');
        if (!href || !href.startsWith('#')) return;
        var target = document.querySelector(href);
        if (target) {
          e.preventDefault();
          isAnchorScroll = true;
          if (anchorTimeout) clearTimeout(anchorTimeout);

          // Keep nav visible during scroll
          nav.classList.remove('hidden');
          nav.classList.add('scrolled');

          target.scrollIntoView({ behavior: 'smooth', block: 'start' });

          // Unlock after scroll settles
          anchorTimeout = setTimeout(function() {
            isAnchorScroll = false;
            lastScroll = window.pageYOffset;
          }, 1200);

          // Update URL without jump
          history.pushState(null, '', href);
        }
      });
    });

    // ============================================================
    //  NAV SCROLL BEHAVIOR
    // ============================================================
    var lastScroll = 0;
    var nav = document.getElementById('mainNav');

    window.addEventListener('scroll', function() {
      var current = window.pageYOffset;

      // Background after 40px
      if (current > 40) {
        nav.classList.add('scrolled');
      } else {
        nav.classList.remove('scrolled');
      }

      // Never hide during anchor scroll
      if (isAnchorScroll) {
        lastScroll = current;
        return;
      }

      // Hide on scroll down past 300px
      if (current > lastScroll && current > 300) {
        nav.classList.add('hidden');
      } else {
        nav.classList.remove('hidden');
      }

      lastScroll = current;
    });

    // ============================================================
    //  SCROLL REVEAL — IntersectionObserver
    // ============================================================
    var revealObserver = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          var delay = entry.target.style.getPropertyValue('--reveal-delay') || '0s';
          entry.target.style.transitionDelay = delay;
          entry.target.classList.add('visible');
          revealObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

    document.querySelectorAll('.reveal-scroll, .feature-card, .stat-item, .shorten-card').forEach(function(el) {
      revealObserver.observe(el);
    });

    // ============================================================
    //  COUNTER ANIMATIONS — triggered by IntersectionObserver
    // ============================================================
    var countersAnimated = false;

    var counterObserver = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting && !countersAnimated) {
          countersAnimated = true;
          animateCountUp();
          animateCountDown();
          counterObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.3 });

    var statsSection = document.querySelector('.stats-section');
    if (statsSection) counterObserver.observe(statsSection);

    // Count UP: 0 → target
    function animateCountUp() {
      document.querySelectorAll('.counter-up').forEach(function(el) {
        var target = parseInt(el.getAttribute('data-target'), 10);
        var prefix = el.getAttribute('data-prefix') || '';
        var suffix = el.getAttribute('data-suffix') || '';
        var sup = el.getAttribute('data-sup') || '';
        var duration = 1600;
        var startTime = null;

        function step(timestamp) {
          if (!startTime) startTime = timestamp;
          var progress = Math.min((timestamp - startTime) / duration, 1);
          // ease-out cubic
          var eased = 1 - Math.pow(1 - progress, 3);
          var current = Math.floor(eased * target);
          el.innerHTML = prefix + current + suffix;
          if (progress < 1) {
            requestAnimationFrame(step);
          } else {
            // Final value
            if (sup) {
              el.innerHTML = prefix + target + suffix + '<sup>' + sup + '</sup>';
            } else {
              el.innerHTML = prefix + target + suffix;
            }
          }
        }

        requestAnimationFrame(step);
      });
    }

    // Count DOWN: from → 0
    function animateCountDown() {
      document.querySelectorAll('.counter-down').forEach(function(el) {
        var from = parseInt(el.getAttribute('data-from'), 10);
        var prefix = el.getAttribute('data-prefix') || '';
        var suffix = el.getAttribute('data-suffix') || '';
        var duration = 1600;
        var startTime = null;

        function step(timestamp) {
          if (!startTime) startTime = timestamp;
          var progress = Math.min((timestamp - startTime) / duration, 1);
          var eased = 1 - Math.pow(1 - progress, 3);
          var current = Math.round(from - (eased * from));
          el.innerHTML = prefix + current + suffix;
          if (progress < 1) {
            requestAnimationFrame(step);
          } else {
            el.innerHTML = prefix + '0' + suffix;
          }
        }

        requestAnimationFrame(step);
      });
    }

    // ============================================================
    //  HERO PARALLAX ON MOUSE
    // ============================================================
    var hero = document.getElementById('hero');
    var heroRight = document.querySelector('.hero-right');
    if (hero && heroRight) {
      hero.addEventListener('mousemove', function(e) {
        var rect = hero.getBoundingClientRect();
        var x = (e.clientX - rect.left) / rect.width - 0.5;
        var y = (e.clientY - rect.top) / rect.height - 0.5;
        heroRight.style.transform = 'translateY(' + (y * -10) + 'px) translateX(' + (x * 6) + 'px)';
      });
      hero.addEventListener('mouseleave', function() {
        heroRight.style.transform = 'translateY(0) translateX(0)';
      });
    }

    // ============================================================
    //  LIVE DEMO ANIMATION
    // ============================================================
    var demoRunning = false;
    function runDemo() {
      if (demoRunning) return;
      demoRunning = true;
      var step1 = document.getElementById('demoStep1');
      var step2 = document.getElementById('demoStep2');
      var step3 = document.getElementById('demoStep3');

      step1.classList.remove('active');
      step2.classList.add('active');

      setTimeout(function() {
        step2.classList.remove('active');
        step3.classList.add('active');
        // Typewriter effect for result URL
        var resultEl = document.getElementById('demoResultUrl');
        var fullText = 'https://shortdesk.app/Ab3xK9';
        resultEl.textContent = '';
        var i = 0;
        var typeInterval = setInterval(function() {
          resultEl.textContent += fullText[i];
          i++;
          if (i >= fullText.length) clearInterval(typeInterval);
        }, 35);
      }, 1500);
    }

    function copyDemo() {
      var btn = document.getElementById('demoCopyBtn');
      btn.textContent = 'Copied!';
      btn.classList.add('copied');
      setTimeout(function() {
        btn.textContent = 'Copy';
        btn.classList.remove('copied');
      }, 2000);
    }

    // Auto-run demo after 2.5s
    setTimeout(function() {
      if (!demoRunning) runDemo();
    }, 2500);

    // ============================================================
    //  ACTIVE NAV LINK
    // ============================================================
    (function() {
      var path = window.location.pathname;
      var links = document.querySelectorAll('.nav-center a');
      links.forEach(function(link) {
        var href = link.getAttribute('href');
        if (href === '/' && (path === '/' || path === '')) {
          link.classList.add('active');
        } else if (href !== '/' && href !== '#features' && path.startsWith(href)) {
          link.classList.add('active');
        }
      });
    })();
  </script>

  <script>
    // ============================================================
    //  THEME TOGGLE
    // ============================================================
    (function() {
      var saved = localStorage.getItem('shortdesk-theme');
      if (saved) document.documentElement.setAttribute('data-theme', saved);
      updateIcon();
    })();

    function toggleTheme() {
      var current = document.documentElement.getAttribute('data-theme');
      var next = current === 'light' ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('shortdesk-theme', next);
      updateIcon();
    }

    function updateIcon() {
      var t = document.documentElement.getAttribute('data-theme');
      document.getElementById('themeIcon').innerHTML = t === 'light' ? '&#9790;' : '&#9789;';
    }
  </script>
